# Python project files (uv tooling for CI/deployment only)
pyproject.toml
uv.lock
.python-version
.venv/

# CI tooling (internal use only)
tool/
.github/
.vscode/
engineering/
# NOTE: `wiki/` is deliberately NOT listed here. It is a git submodule, and
# listing it makes `pub publish --dry-run` fail with "checked-in file is
# ignored" in CI, where the submodule is not checked out. CI publishes with an
# empty wiki/ directory, so nothing from it is included in the archive.
# Re-adding it will break the release pipeline.
Makefile
CLAUDE.md

# Claude
.claude/

# Build and tooling output. These MUST be listed here: a .pubignore fully
# REPLACES .gitignore for publishing, so the /build/, /coverage/, doc/api/,
# .dart_tool/ and *.iml exclusions in .gitignore no longer apply.
build/
coverage/
doc/
.dart_tool/
*.iml
.idea/
