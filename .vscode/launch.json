{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run example (debug)",
      "request": "launch",
      "type": "dart",
      "cwd": "example",
      "program": "lib/main.dart"
    },
    {
      "name": "Run example (profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "example",
      "program": "lib/main.dart",
      "args": ["--profile"]
    },
    {
      "name": "Run example (web-server)",
      "request": "launch",
      "type": "dart",
      "cwd": "example",
      "program": "lib/main.dart",
      "args": ["-d", "web-server", "--web-port", "8080"]
    }
  ]
}