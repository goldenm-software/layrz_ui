     // If focusNode changed, update the reference
     if (widget.focusNode != oldWidget.focusNode) {
-      if (oldWidget.focusNode == null) {
-        _focusNode.dispose();
+      // Don't dispose the old focusNode here; it will be handled in dispose()
+      // when this state is destroyed. Just update the reference.
+      if (widget.focusNode == null) {
+        // New widget doesn't provide a focusNode, so create an internal one
+        _internalFocusNode = FocusNode();
+        _focusNode = _internalFocusNode!;
+      } else {
+        // New widget provides a focusNode, use it directly
+        _internalFocusNode = null;
+        _focusNode = widget.focusNode!;
       }
-      _focusNode = widget.focusNode ?? FocusNode();
     }
   }
 
   @override
   void dispose() {
-    // Only dispose if we created them
-    if (widget.controller == null) {
-      _controller.dispose();
-    }
-    if (widget.focusNode == null) {
-      _focusNode.dispose();
-    }
+    // Only dispose internal instances that we created
+    _internalController?.dispose();
+    _internalFocusNode?.dispose();
     super.dispose();
   }
 
